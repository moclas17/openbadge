# =============================================================================
# OpenBadge Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://openbadge:openbadge@localhost:5432/openbadge

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secret used to sign session tokens (JWT). Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-use-openssl-rand-hex-32
# Session duration in seconds (default: 7 days)
SESSION_TTL=604800
# SIWE domain (must match the domain serving the frontend)
SIWE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Blockchain — Base Sepolia (Testnet)
# -----------------------------------------------------------------------------
# Chain IDs: Base Sepolia = 84532, Base Mainnet = 8453
CHAIN_ID=84532
# RPC URL for the target chain
RPC_URL=https://sepolia.base.org
# Optional WebSocket RPC for event subscriptions
RPC_WS_URL=wss://sepolia.base.org
# Deployed OpenBadge contract address (set after first deploy)
CONTRACT_ADDRESS=

# Minter wallet private key (used by worker to sign mint transactions)
# In production, use a KMS signer or hardware wallet
MINTER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Storage (MinIO / S3-compatible)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=openbadge
S3_SECRET_KEY=openbadge
S3_BUCKET=openbadge
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Public URL used to serve uploaded files (base URL, WITHOUT bucket; the app appends /{bucket}/{key})
S3_PUBLIC_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# IPFS (Kubo node in Docker)
# -----------------------------------------------------------------------------
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Queue (BullMQ via Redis)
# -----------------------------------------------------------------------------
QUEUE_CONCURRENCY_MINT=5
QUEUE_CONCURRENCY_METADATA=10
QUEUE_CONCURRENCY_EXPORT=2

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Indexer
# -----------------------------------------------------------------------------
# Block number to start indexing from (set to deployment block for efficiency)
INDEXER_START_BLOCK=0
# How many blocks to process per batch
INDEXER_BATCH_SIZE=100
# Poll interval in ms when no new blocks
INDEXER_POLL_INTERVAL_MS=3000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
